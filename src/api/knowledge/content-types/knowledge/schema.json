{
  "kind": "collectionType",
  "collectionName": "knowledge_entries",
  "info": {
    "singularName": "knowledge",
    "pluralName": "knowledge-entries",
    "displayName": "知识条目",
    "description": "美食知识库条目"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "technique",
        "ingredient",
        "flavor",
        "culture",
        "history"
      ],
      "required": true
    },
    "content": {
      "type": "richtext",
      "required": true
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "relatedRecipes": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::recipe.recipe",
      "mappedBy": "relatedKnowledge"
    },
    "relatedKnowledge": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::knowledge.knowledge"
    }
  }
}