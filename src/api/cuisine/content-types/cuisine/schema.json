{
  "kind": "collectionType",
  "collectionName": "cuisines",
  "info": {
    "singularName": "cuisine",
    "pluralName": "cuisines",
    "displayName": "菜系",
    "description": "川菜、粤菜、湘菜等菜系分类"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "regions": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::region.region",
      "inversedBy": "cuisines"
    },
    "methods": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::method.method",
      "inversedBy": "cuisines"
    },
    "recipes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::recipe.recipe",
      "mappedBy": "cuisine"
    }
  }
}
