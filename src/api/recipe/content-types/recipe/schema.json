{
  "kind": "collectionType",
  "collectionName": "recipes",
  "info": {
    "singularName": "recipe",
    "pluralName": "recipes",
    "displayName": "食谱",
    "description": "食谱内容类型"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "difficulty": {
      "type": "enumeration",
      "enum": [
        "easy",
        "simple",
        "medium",
        "hard"
      ],
      "required": true,
      "default": "easy"
    },
    "cookTime": {
      "type": "integer"
    },
    "servings": {
      "type": "integer"
    },
    "calories": {
      "type": "integer"
    },
    "protein": {
      "type": "float"
    },
    "carbs": {
      "type": "float"
    },
    "fat": {
      "type": "float"
    },
    "ingredients": {
      "type": "component",
      "repeatable": true,
      "component": "recipe.ingredient"
    },
    "steps": {
      "type": "component",
      "repeatable": true,
      "component": "recipe.step"
    },
    "cuisine": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::cuisine.cuisine",
      "inversedBy": "recipes"
    },
    "regions": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::region.region",
      "inversedBy": "recipes"
    },
    "methods": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::method.method",
      "inversedBy": "recipes"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag",
      "inversedBy": "recipes"
    },
    "relatedRecipes": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::recipe.recipe"
    },
    "relatedKnowledge": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::knowledge.knowledge",
      "inversedBy": "relatedRecipes"
    },
    "history": {
      "type": "richtext"
    }
  }
}